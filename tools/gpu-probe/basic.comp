#version 440
layout(local_size_x=16, local_size_y=16) in;
layout(std140, binding=0) uniform Params {
    vec4 balanceExposure; // RGB balance, exposure multiplier
    vec4 tone; // contrast multiplier, saturation, reserved, reserved
} params;
layout(binding=1) uniform sampler2D sourceImage;
layout(rgba32f, binding=2) writeonly uniform image2D targetImage;
void main() {
    ivec2 pos=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pos,imageSize(targetImage)))) return;
    vec4 pixel=texelFetch(sourceImage,pos,0);
    float alpha=clamp(pixel.a,0.0,1.0);
    vec3 color=vec3(0.0);
    if(alpha>1e-8) {
        color=pixel.rgb*params.balanceExposure.rgb;
        color=(color*params.balanceExposure.a-vec3(0.18))*params.tone.x+vec3(0.18);
        float y=dot(color,vec3(0.2627,0.6780,0.0593));
        color=vec3(y)+(color-vec3(y))*params.tone.y;
    }
    imageStore(targetImage,pos,vec4(color,alpha));
}
