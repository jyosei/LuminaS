// Included in the private probe namespace; all QRhi resources belong to the
// QRhiWidget's instance and GUI thread. No sharing with the offscreen instance.
class GpuCanvas final:public QRhiWidget {
public:
    explicit GpuCanvas(const SourceFrame &source,bool local=false):source(source),localMode(local){
        setApi(Api::Direct3D11);setFixedColorBufferSize(source.linear.size());
        connect(this,&QRhiWidget::frameSubmitted,this,[this]{submittedEpoch=recordedEpoch;if(ready&&feedback)feedback();});
        connect(this,&QRhiWidget::renderFailed,this,[this]{error="QRhiWidget render failed";if(feedback)feedback();});
    }
    ~GpuCanvas() override{releaseResources();}
    void shutdown(){feedback={};hide();releaseResources();}
    QJsonObject resourceSnapshot() const{return memory(owner);}
    SourceFrame source;Recipe recipe;QString error;
    bool localMode=false;QVector<float> coverage;
    quint64 requestedEpoch=0,recordedEpoch=0,submittedEpoch=0;
    std::function<void()> feedback;
    bool ready=false;
    int uploads=0,maskUploads=0,rendered=0;
protected:
    void releaseResources() override{
        ready=false;graphics.reset();displayBindings.reset();encoding.reset();displayUniform.reset();compute.reset();localCompute.reset();owner=nullptr;
    }
    void initialize(QRhiCommandBuffer *) override{
        try{
            if(owner!=rhi())releaseResources();owner=rhi();
            if(compute||localCompute)return;
            require(owner&&owner->isFeatureSupported(QRhi::Compute),"Widget compute unavailable");
            if(localMode)localCompute=std::make_unique<LocalPipeline>(owner,source.linear.size());
            else compute=std::make_unique<Pipeline>(owner,source.linear.size());
            needsUpload=true;
            // Fixed sRGB display path, generated by the same Little CMS recipe
            // as workToSrgbAffine. Never substitutes for arbitrary monitor ICC.
            auto work=workProfile(),linear=linearSrgbProfile(),encoded=cmsCreate_sRGBProfile();
            require(work&&linear&&encoded,"Display profile allocation failed");
            auto matrixTransform=cmsCreateTransform(work,TYPE_RGB_FLT,linear,TYPE_RGB_FLT,INTENT_RELATIVE_COLORIMETRIC,cmsFLAGS_NOOPTIMIZE|cmsFLAGS_NOCACHE);
            auto encodingTransform=cmsCreateTransform(linear,TYPE_RGB_FLT,encoded,TYPE_RGB_8,INTENT_RELATIVE_COLORIMETRIC,cmsFLAGS_NOOPTIMIZE|cmsFLAGS_NOCACHE);
            require(matrixTransform&&encodingTransform,"Display transform creation failed");
            const float basis[]{1,0,0,0,1,0,0,0,1};float columns[9];cmsDoTransform(matrixTransform,basis,columns,3);
            for(int row=0;row<3;++row)for(int col=0;col<3;++col)matrix[row*4+col]=columns[col*3+row];
            std::vector<float> ramp(65536*3);std::vector<quint8> bytes(65536*3);
            for(int i=0;i<65536;++i)for(int c=0;c<3;++c)ramp[i*3+c]=float(i)/65535;
            cmsDoTransform(encodingTransform,ramp.data(),bytes.data(),65536);
            lut=QImage(256,256,QImage::Format_Grayscale8);require(!lut.isNull(),"Display LUT allocation failed");
            for(int i=0;i<65536;++i)lut.bits()[i]=bytes[i*3];
            cmsDeleteTransform(matrixTransform);cmsDeleteTransform(encodingTransform);cmsCloseProfile(work);cmsCloseProfile(linear);cmsCloseProfile(encoded);
            encoding.reset(owner->newTexture(QRhiTexture::R8,{256,256}));
            displayUniform.reset(owner->newBuffer(QRhiBuffer::Dynamic,QRhiBuffer::UniformBuffer,48));
            require(encoding->create()&&displayUniform->create(),"Display resource allocation failed");
            displayBindings.reset(owner->newShaderResourceBindings());displayBindings->setBindings({
                QRhiShaderResourceBinding::uniformBuffer(0,QRhiShaderResourceBinding::FragmentStage,displayUniform.get()),
                QRhiShaderResourceBinding::sampledTexture(1,QRhiShaderResourceBinding::FragmentStage,localMode?localCompute->output.get():compute->output.get(),localMode?localCompute->sampler.get():compute->sampler.get()),
                QRhiShaderResourceBinding::sampledTexture(2,QRhiShaderResourceBinding::FragmentStage,encoding.get(),localMode?localCompute->sampler.get():compute->sampler.get())});
            require(displayBindings->create(),"Display bindings failed");
            auto shader=[](const QString &path){QFile file(path);require(file.open(QIODevice::ReadOnly),"Display shader missing");return QShader::fromSerialized(file.readAll());};
            graphics.reset(owner->newGraphicsPipeline());graphics->setShaderStages({
                {QRhiShaderStage::Vertex,shader(":/gpu/tools/gpu-probe/present.vert.qsb")},
                {QRhiShaderStage::Fragment,shader(":/gpu/tools/gpu-probe/present.frag.qsb")}});
            graphics->setShaderResourceBindings(displayBindings.get());graphics->setRenderPassDescriptor(renderTarget()->renderPassDescriptor());
            require(graphics->create(),"Display pipeline failed");
            ready=true;
        }catch(const std::exception &failure){error=QString::fromUtf8(failure.what());}
    }
    void render(QRhiCommandBuffer *cb) override{
        if(!ready)return;
        try{
            recordedEpoch=requestedEpoch;
            if(localMode)localCompute->record(cb,source.linear,coverage,nativeLocalParameters(recipe),.65f,needsUpload);
            else compute->record(cb,source.linear,recipe,needsUpload);
            auto *updates=owner->nextResourceUpdateBatch();
            updates->updateDynamicBuffer(displayUniform.get(),0,sizeof(matrix),matrix);
            if(needsUpload)updates->uploadTexture(encoding.get(),lut);
            cb->beginPass(renderTarget(),Qt::black,{1,0},updates);
            cb->setGraphicsPipeline(graphics.get());cb->setShaderResources();
            cb->setViewport(QRhiViewport(0,0,float(renderTarget()->pixelSize().width()),float(renderTarget()->pixelSize().height())));
            cb->draw(3);cb->endPass();++rendered;
            if(needsUpload){++uploads;if(localMode)++maskUploads;needsUpload=false;}
        }catch(const std::exception &failure){error=QString::fromUtf8(failure.what());}
    }
private:
    QRhi *owner=nullptr;
    std::unique_ptr<Pipeline> compute;
    std::unique_ptr<LocalPipeline> localCompute;
    bool needsUpload=true;
    std::unique_ptr<QRhiBuffer> displayUniform;
    std::unique_ptr<QRhiTexture> encoding;
    std::unique_ptr<QRhiShaderResourceBindings> displayBindings;
    std::unique_ptr<QRhiGraphicsPipeline> graphics;
    float matrix[12]{};QImage lut;
};
class CpuCanvas final:public QWidget {
public:
    explicit CpuCanvas(const SourceFrame &source,bool local=false):source(source),localMode(local){}
    SourceFrame source;Recipe recipe;QString error;std::function<void()> feedback;
    bool localMode=false;quint64 requestedEpoch=0,submittedEpoch=0;
    LocalEdit::LocalPreviewCache localCache;
protected:
    void paintEvent(QPaintEvent *) override{
        const auto epoch=requestedEpoch;
        const auto doc=localMode?nativeLocalDocument(source,recipe):LocalEdit::PhotoDocument{};
        auto result=localMode?LocalEdit::renderDocumentPreview(source,doc,doc.global,3840,nullptr,{}, {},&localCache):renderFrame(source,recipe,0);error=result.error;
        {QPainter painter(this);painter.fillRect(rect(),Qt::black);if(!result.image.isNull())painter.drawImage(rect(),result.image);}
        submittedEpoch=epoch;if(feedback)feedback();
    }
};
template<class Canvas> QJsonObject runNative(Canvas &canvas,int iterations,const QString &name,const QString &capturePath={}){
    QWidget window;window.setWindowTitle("LuminaS GPU experiment — "+name+" — fixed sRGB");
    auto *layout=new QVBoxLayout(&window);auto *caption=new QLabel("Synthetic 4K float32 • resident input • exposure updates • no production backend changes");
    auto *slider=new QSlider(Qt::Horizontal);slider->setRange(-100,100);
    layout->addWidget(caption);layout->addWidget(&canvas,1);layout->addWidget(slider);
    const auto detach=qScopeGuard([&]{
        if constexpr(std::is_same_v<Canvas,GpuCanvas>)canvas.shutdown();
        canvas.setParent(nullptr);
    });
    std::vector<double> samples;QElapsedTimer eventTimer;int sequence=0,rejectedEpochs=0;bool waiting=false,finished=false;quint64 waitingEpoch=0;
    QEventLoop loop;QTimer timeout;timeout.setSingleShot(true);
    QObject::connect(&timeout,&QTimer::timeout,&loop,[&]{loop.quit();});
    std::function<void()> next=[&]{
        if(sequence>=iterations+5){finished=true;loop.quit();return;}
        waiting=true;waitingEpoch=quint64(sequence)+1;canvas.requestedEpoch=waitingEpoch;
        eventTimer.restart();slider->setValue((sequence%101)-50);
        canvas.recipe.exposure=slider->value()/100.;canvas.recipe.saturation=1.25;
        canvas.update();
    };
    canvas.feedback=[&]{
        if(!canvas.error.isEmpty()){loop.quit();return;}
        if(!waiting)return;
        if(canvas.submittedEpoch!=waitingEpoch){++rejectedEpochs;return;}waiting=false;
        if(sequence>=5)samples.push_back(elapsed(eventTimer));++sequence;
        QTimer::singleShot(0,&window,next);
    };
    window.resize(1000,740);window.show();timeout.start(120000);
    QTimer::singleShot(250,&window,next);loop.exec();
    QJsonObject report{{"eventToFeedback",distribution(samples)},{"completed",finished},{"error",canvas.error},
        {"lastRequestedEpoch",double(canvas.requestedEpoch)},{"lastSubmittedEpoch",double(canvas.submittedEpoch)},
        {"rejectedOldFeedback",rejectedEpochs},{"dpr",canvas.devicePixelRatioF()},
        {"sourceWidth",canvas.source.linear.width()},{"sourceHeight",canvas.source.linear.height()},
        {"measurement",name=="GPU"?"slider update to QRhiWidget frameSubmitted; excludes physical display scanout":"slider update to QWidget paint completion; excludes physical display scanout"}};
    canvas.feedback={};
    if constexpr(std::is_same_v<Canvas,CpuCanvas>){
        if(canvas.localMode){const auto stats=canvas.localCache.stats();
            report.insert("localCache",QJsonObject{{"builds",double(stats.builds)},{"hits",double(stats.hits)},
                {"retainedBytes",double(stats.retainedBytes)}});}
    }
    if constexpr(std::is_same_v<Canvas,GpuCanvas>){
        auto rawGrab=canvas.grabFramebuffer();
        // Qt 6.8 returns RGBA8888 for QRhiWidget readback, while our color
        // attachment deliberately contains premultiplied pixels for QWidget
        // composition. Label those existing bytes; do not multiply alpha twice.
        if(rawGrab.format()==QImage::Format_RGBA8888)rawGrab.reinterpretAsFormat(QImage::Format_RGBA8888_Premultiplied);
        const auto grabbed=rawGrab.convertToFormat(QImage::Format_RGBA8888_Premultiplied);
        QString error;QImage linear;
        if(canvas.localMode){const auto doc=nativeLocalDocument(canvas.source,canvas.recipe);
            linear=LocalEdit::renderDocumentPreviewLinear(canvas.source,doc,doc.global,3840,error);}
        else linear=renderLinear(canvas.source,canvas.recipe,0,error);
        auto reference=workToSrgb(linear,error).convertToFormat(QImage::Format_RGBA8888_Premultiplied);
        require(error.isEmpty()&&grabbed.size()==reference.size()&&!grabbed.isNull(),"Native display readback dimensions/error");
        quint64 failures=0;int maxError=0;
        for(int y=0;y<reference.height();++y)for(int x=0;x<reference.width()*4;++x){
            const int difference=std::abs(int(grabbed.constScanLine(y)[x])-int(reference.constScanLine(y)[x]));
            maxError=std::max(maxError,difference);if(difference>1)++failures;
        }
        report.insert("displayPixelCheck",QJsonObject{{"maxByteError",maxError},{"channelsBeyondOneCode",double(failures)},{"passed",failures==0}});
        report.insert("memoryBeforeRelease",canvas.resourceSnapshot());
        if(failures){
            throw std::runtime_error(QString("Display mismatch: format=%1 max=%2 failedChannels=%3 sample=%4 expected=%5 flipped=%6")
                .arg(int(rawGrab.format())).arg(maxError).arg(failures)
                .arg(grabbed.pixelColor(101,20).name(QColor::HexArgb),reference.pixelColor(101,20).name(QColor::HexArgb),reference.pixelColor(101,reference.height()-21).name(QColor::HexArgb)).toStdString());
        }
        if(!capturePath.isEmpty())require(!QFile::exists(capturePath)&&window.grab().save(capturePath),"Cannot save new synthetic native capture");
    }
    if constexpr(std::is_same_v<Canvas,GpuCanvas>)canvas.shutdown();
    canvas.setParent(nullptr);window.close();
    require(finished&&canvas.error.isEmpty(),"Native feedback experiment failed or timed out");return report;
}
QJsonObject runPresentation(int iterations,const QString &capturePath,bool local=false){
    auto source=synthetic({3840,2560});source.path="synthetic-native";source.sha256=QString(64,'a');QJsonObject result;
    // Exercise dark/midtones densely; retain sparse original HDR/negative values
    // rather than validating only the heavily clipped first-round HDR pattern.
    if(local)for(int y=0;y<source.linear.height();++y){
        auto *row=reinterpret_cast<float *>(source.linear.scanLine(y));
        for(int x=0;x<source.linear.width();++x)if(x%127!=0)
            for(int c=0;c<3;++c)row[x*4+c]*=.1f;
    }
    // Keep the GPU widget alive until its actual output is checked. Only one
    // benchmark runs at a time so CPU timings do not contend with GPU runs.
    {
        GpuCanvas gpu(source,local);
        if(local){QElapsedTimer timer;timer.start();const LocalEdit::PreparedBrushMask mask(residentMask(source.linear.size()));QString error;
            require(LocalEdit::rasterizeMaskPreview(mask,{source.originalSize,source.linear.size(),{}},source.linear,gpu.coverage,error),"Native CPU mask preparation failed");
            result.insert("maskPreparationMs",elapsed(timer));result.insert("maskBytes",double(gpu.coverage.size()*sizeof(float)));}
        result.insert("gpu",runNative(gpu,iterations,"GPU",capturePath));
        result.insert("sourceUploadsDuringMeasuredRun",gpu.uploads);result.insert("maskUploadsDuringMeasuredRun",gpu.maskUploads);
        result.insert("renderedFrames",gpu.rendered);
    }
    result.insert("memoryAfterGpuWidgetDestroyed",memory(nullptr));
    {CpuCanvas cpu(source,local);result.insert("cpu",runNative(cpu,iterations,"CPU"));}
    result.insert("memoryAfterNativeRuns",memory(nullptr));
    result.insert("localMode",local);
    result.insert("limitations",QJsonArray{"fixed sRGB only; no arbitrary monitor ICC or soft proof", "two sequential native windows, no physical input-to-photon measurement", "100 serial exposure updates after 5 warmups; no promise of 30/60 fps", "GPU frameSubmitted differs from CPU paint completion; epochs reject older submissions", "synthetic single resident layer; no source/mask changes during timing"});
    return result;
}
