# Explicit local SDKs; never download dependencies during an application build.
set(TIFF_SOURCE_DIR "${CMAKE_SOURCE_DIR}/.tools/export-deps/tiff-4.7.1" CACHE PATH "LibTIFF 4.7.1 source")
set(ZLIB_ROOT "${CMAKE_SOURCE_DIR}/.tools/export-deps/zlib-install" CACHE PATH "zlib 1.3.1 SDK")
set(ZLIB_USE_STATIC_LIBS ON)
find_package(ZLIB REQUIRED)
if(NOT EXISTS "${TIFF_SOURCE_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "Missing LibTIFF SDK; see docs/engineering/EXPORT-V1.md")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(feature tiff-tools tiff-tests tiff-contrib tiff-docs tiff-install jpeg jbig lzma zstd webp lerc libdeflate pixarlog)
  set(${feature} OFF CACHE BOOL "" FORCE)
endforeach()
set(zlib ON CACHE BOOL "" FORCE)
add_subdirectory("${TIFF_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/tiff" EXCLUDE_FROM_ALL)
